{
  "name": "dsh-local-files",
  "version": "0.1.0",
  "description": "Local file manager for DeepSeek Harness Web: browse, preview, download, upload, edit, rename and delete host files from the browser, over the same authenticated DSH web server",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperYe/dsh-local-files.git"
  },
  "homepage": "https://github.com/DeveloperYe/dsh-local-files#readme",
  "bugs": {
    "url": "https://github.com/DeveloperYe/dsh-local-files/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "file-manager",
    "file-browser",
    "upload",
    "download",
    "xlsx",
    "docx"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/page.html",
    "lib/vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "license": "MIT"
}
